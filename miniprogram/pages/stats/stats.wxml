<!-- pages/stats/stats.wxml -->
<view class="stats-container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 内容区域 -->
  <view wx:else>
    <!-- 统计卡片 -->
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-number">{{stats.resumeCount}}</text>
        <text class="stat-label">简历总数</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{stats.aiCount}}</text>
        <text class="stat-label">AI 优化次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{stats.exportCount}}</text>
        <text class="stat-label">导出次数</text>
      </view>
      <view class="stat-card">
        <text class="stat-number">{{stats.templateCount}}</text>
        <text class="stat-label">收藏模板</text>
      </view>
    </view>

    <!-- 最近简历 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">最近编辑</text>
        <text class="section-more" bindtap="goToResumes">查看全部 ›</text>
      </view>

      <view class="resume-list" wx:if="{{recentResumes.length > 0}}">
        <view class="resume-item" wx:for="{{recentResumes}}" wx:key="_id" bindtap="viewResume" data-id="{{item._id}}">
          <view class="resume-icon">📄</view>
          <view class="resume-info">
            <text class="resume-name">{{item.name || '未命名简历'}}</text>
            <text class="resume-time">{{item.updatedAt}}</text>
          </view>
          <text class="resume-arrow">›</text>
        </view>
      </view>

      <view class="empty-hint" wx:else>
        <text>还没有简历</text>
      </view>
    </view>
  </view>
</view>
