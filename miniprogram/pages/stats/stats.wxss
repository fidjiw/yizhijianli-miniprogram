/* pages/stats/stats.wxss */

.stats-container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 120rpx;
  background: #F4F8F9;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
}

.loading-text {
  font-size: 28rpx;
  color: #8F9BA8;
}

/* 统计网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(30, 50, 60, 0.06);
}

.stat-number {
  font-size: 48rpx;
  font-weight: 800;
  color: #2DD4BF;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8F9BA8;
  font-weight: 600;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 50, 60, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E3240;
}

.section-more {
  font-size: 24rpx;
  color: #0FB9A6;
  font-weight: 600;
}

/* 简历列表 */
.resume-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.resume-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F4F8F9;
  border-radius: 16rpx;
}

.resume-icon {
  font-size: 36rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 12rpx;
}

.resume-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.resume-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E3240;
}

.resume-time {
  font-size: 22rpx;
  color: #8F9BA8;
}

.resume-arrow {
  font-size: 28rpx;
  color: #C4CCD4;
}

/* 空提示 */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
  color: #8F9BA8;
}
