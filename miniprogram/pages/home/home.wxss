/* pages/home/home.wxss */
.home-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 新建简历卡片 */
.create-card {
  margin: 28rpx 36rpx;
  background: linear-gradient(120deg, #2DD4BF, #0FB9A6);
  border-radius: 40rpx;
  padding: 36rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(45, 212, 191, 0.25);
}

.create-content {
  position: relative;
  z-index: 2;
}

.create-title {
  font-size: 30rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.create-desc {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}

.create-emoji {
  position: absolute;
  right: -20rpx;
  bottom: -28rpx;
  font-size: 128rpx;
  opacity: 0.25;
}

/* 快捷功能 */
.quick-actions {
  margin: 0 36rpx;
  display: flex;
  gap: 20rpx;
}

.action-item {
  flex: 1;
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 22rpx;
  font-weight: 600;
}

/* 我的简历 */
.my-resumes-section {
  margin-top: 36rpx;
  padding: 0 36rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-weight: 700;
  font-size: 28rpx;
}

.section-more {
  font-size: 22rpx;
  color: #0FB9A6;
}

/* 简历卡片 */
.resume-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.resume-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 22rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.05);
}

.resume-thumbnail {
  width: 142rpx;
  height: 184rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #E6FBF7, #fff);
  border: 1px solid #EEF1F4;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
  padding: 10rpx;
  box-sizing: border-box;
}

.resume-mini-paper {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 12rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 18rpx rgba(30, 50, 60, 0.12);
}

.resume-mini-accent {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 6rpx;
}

.resume-mini-name {
  display: block;
  margin-top: 4rpx;
  font-size: 17rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-mini-role {
  display: block;
  margin-top: 3rpx;
  font-size: 13rpx;
  line-height: 1.2;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-mini-summary {
  display: -webkit-box;
  margin-top: 6rpx;
  font-size: 12rpx;
  line-height: 1.35;
  color: #4B5563;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.resume-mini-section {
  margin-top: 8rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid #EEF2F7;
}

.resume-mini-line {
  display: flex;
  align-items: flex-start;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.resume-mini-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  margin-top: 7rpx;
  flex-shrink: 0;
}

.resume-mini-text {
  flex: 1;
  min-width: 0;
  font-size: 11rpx;
  line-height: 1.35;
  color: #6B7280;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.resume-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.resume-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-position {
  font-size: 24rpx;
  color: #334155;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-time {
  font-size: 23rpx;
  color: #6B7787;
  margin-bottom: 12rpx;
}

.resume-tag {
  display: flex;
}

.resume-more {
  color: #C4CCD4;
  font-size: 40rpx;
  line-height: 1;
}
