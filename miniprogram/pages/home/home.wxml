<!--pages/home/home.wxml-->
<view class="home-container">
  <!-- 新建简历卡片 -->
  <view class="create-card" bindtap="handleCreateResume">
    <view class="create-content">
      <text class="create-title">＋ 新建简历</text>
      <text class="create-desc">从模板开始，或让 AI 帮你起草</text>
    </view>
    <text class="create-emoji">📝</text>
  </view>

  <!-- 快捷功能 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goToTemplates">
      <text class="action-icon">🎨</text>
      <text class="action-text">模板库</text>
    </view>
    <view class="action-item" bindtap="goToAI">
      <text class="action-icon">🤖</text>
      <text class="action-text">AI 润色</text>
    </view>
    <view class="action-item" bindtap="goToExport">
      <text class="action-icon">📤</text>
      <text class="action-text">导出</text>
    </view>
  </view>

  <!-- 我的简历 -->
  <view class="my-resumes-section">
    <view class="section-header">
      <text class="section-title">我的简历</text>
      <text class="section-more" bindtap="goToMyResumes">全部 ›</text>
    </view>

    <!-- 简历列表 -->
    <view class="resume-list">
      <view class="resume-card" wx:for="{{resumeList}}" wx:key="id" bindtap="handleResumeClick" data-id="{{item.id}}">
        <view class="resume-thumbnail">
          <view class="resume-mini-paper">
            <view class="resume-mini-accent" style="background: {{item.preview.accent}};"></view>
            <text class="resume-mini-name">{{item.preview.name}}</text>
            <text class="resume-mini-role" style="color: {{item.preview.accent}};">{{item.preview.position}}</text>
            <text class="resume-mini-summary">{{item.preview.summary}}</text>
            <view class="resume-mini-section">
              <view class="resume-mini-line" wx:for="{{item.preview.lines}}" wx:for-item="line" wx:key="*this">
                <text class="resume-mini-dot" style="background: {{item.preview.accent}};"></text>
                <text class="resume-mini-text">{{line}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="resume-info">
          <text class="resume-title">{{item.title}}</text>
          <text class="resume-position">{{item.position}}</text>
          <text class="resume-time">更新于 {{item.updateTime}}</text>
          <view class="resume-tag">
            <text class="chip">完成度 {{item.progress}}%</text>
          </view>
        </view>
        <text class="resume-more">⋯</text>
      </view>
    </view>
  </view>
</view>
