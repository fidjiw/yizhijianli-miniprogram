/* pages/editor/editor.wxss */
.editor-container {
  min-height: 100vh;
  background: #F4F8F9;
  padding-bottom: 160rpx;
}

/* 顶部导航 */
.nav-bar {
  background: #fff;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #EEF1F4;
}

.nav-icon {
  font-size: 36rpx;
  color: #6B7787;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-weight: 700;
  font-size: 30rpx;
  color: #1E3240;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.save-status {
  font-size: 22rpx;
  color: #8F9BA8;
}

.btn-preview {
  font-size: 26rpx;
  color: #0FB9A6;
  font-weight: 600;
  background: transparent;
  border: none;
  padding: 0;
}

.btn-preview::after {
  border: none;
}

/* 模块tabs */
.tabs-scroll {
  background: #fff;
  padding: 16rpx 32rpx;
  white-space: nowrap;
  border-bottom: 1px solid #EEF1F4;
}

.tabs {
  display: flex;
  gap: 16rpx;
}

.tab-item {
  font-size: 26rpx;
  color: #8F9BA8;
  font-weight: 600;
  padding: 12rpx 24rpx;
  background: #F4F8F9;
  border-radius: 40rpx;
  flex-shrink: 0;
}

.tab-item.active {
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
}

/* 表单内容 */
.form-content {
  padding: 24rpx 32rpx;
  height: calc(100vh - 280rpx);
}

/* 区块头部 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E3240;
}

.btn-add {
  font-size: 24rpx;
  color: #0FB9A6;
  font-weight: 600;
  background: #E6FBF7;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-add::after {
  border: none;
}

/* 表单区块 */
.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 50, 60, 0.06);
  position: relative;
}

.section-delete {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 24rpx;
  color: #FF4D4F;
  font-weight: 600;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #6B7787;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  background: #F4F8F9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1E3240;
  border: none;
}

.form-textarea {
  width: 100%;
  background: #F4F8F9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1E3240;
  min-height: 160rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-item.half {
  flex: 1;
}

/* 技能列表 */
.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-item {
  background: #fff;
  border-radius: 40rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(30, 50, 60, 0.06);
}

.skill-input {
  border: none;
  background: transparent;
  font-size: 26rpx;
  color: #1E3240;
  min-width: 120rpx;
}

.skill-delete {
  font-size: 32rpx;
  color: #C4CCD4;
  font-weight: 300;
}

/* 空提示 */
.empty-hint {
  text-align: center;
  padding: 80rpx 0;
}

.empty-hint text {
  display: block;
  font-size: 26rpx;
  color: #8F9BA8;
  margin-bottom: 32rpx;
}

.btn-add-large {
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(15, 185, 166, 0.3);
}

.btn-add-large::after {
  border: none;
}

/* AI辅助卡片 */
.ai-assist-card {
  background: linear-gradient(120deg, #FFF9E6, #FFF3D6);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 193, 7, 0.15);
}

.ai-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.ai-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #7A5200;
}

.ai-desc {
  font-size: 24rpx;
  color: #8F9BA8;
}

.ai-btn {
  background: #FFC24B;
  color: #7A5200;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  flex-shrink: 0;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(30, 50, 60, 0.06);
  z-index: 100;
}

.btn-secondary {
  flex: 1;
  background: #F4F8F9;
  color: #1E3240;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 185, 166, 0.3);
  border: none;
}

.btn-primary::after {
  border: none;
}
