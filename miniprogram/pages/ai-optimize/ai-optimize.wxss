/* pages/ai-optimize/ai-optimize.wxss */

.ai-container {
  min-height: 100vh;
  background: #F4F8F9;
  padding-bottom: 160rpx;
}

/* 顶部导航 */
.nav-bar {
  background: #fff;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #EEF1F4;
}

.nav-icon {
  font-size: 36rpx;
  color: #6B7787;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-weight: 700;
  font-size: 30rpx;
  color: #1E3240;
}

/* 分析中状态 */
.analyzing {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 80rpx 0;
}

.analyzing-animation {
  font-size: 120rpx;
  animation: bounce 1.5s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

.analyzing-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E3240;
  margin-top: 32rpx;
  margin-bottom: 12rpx;
}

.analyzing-desc {
  font-size: 24rpx;
  color: #8F9BA8;
}

/* 评分卡片 */
.score-card {
  margin: 32rpx;
  padding: 48rpx;
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  border-radius: 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(15, 185, 166, 0.3);
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.score-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 24rpx;
}

.score-number {
  font-size: 96rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.score-total {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.score-tip {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

/* 建议区块 */
.suggestions-section {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E3240;
}

.suggestion-count {
  font-size: 24rpx;
  color: #fff;
  background: #FF6B6B;
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
  font-weight: 600;
}

/* 建议列表 */
.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 50, 60, 0.06);
}

.suggestion-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.suggestion-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.suggestion-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E3240;
}

.suggestion-desc {
  font-size: 24rpx;
  color: #6B7787;
  line-height: 1.6;
}

.suggestion-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.btn-detail {
  background: #F4F8F9;
  color: #6B7787;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-detail::after {
  border: none;
}

.btn-apply {
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  border: none;
}

.btn-apply::after {
  border: none;
}

.btn-apply.applied {
  background: #E6FBF7;
  color: #0FB9A6;
}

.btn-apply[disabled] {
  opacity: 0.5;
}

/* 无建议状态 */
.no-suggestions {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  text-align: center;
}

.no-suggestions-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.no-suggestions-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E3240;
  margin-bottom: 16rpx;
}

.no-suggestions-desc {
  font-size: 26rpx;
  color: #8F9BA8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(30, 50, 60, 0.06);
}

.btn-secondary {
  flex: 1;
  background: #F4F8F9;
  color: #1E3240;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 185, 166, 0.3);
  border: none;
}

.btn-primary::after {
  border: none;
}
