/* pages/ai-optimize/ai-optimize.wxss */
.ai-container {
  min-height: 100vh;
  padding: 36rpx;
  padding-bottom: 180rpx;
}

.header-bar {
  text-align: center;
  padding: 20rpx 0;
  background: #fff;
  margin: -36rpx -36rpx 36rpx;
  border-bottom: 1px solid #EEF1F4;
}

.page-title {
  font-weight: 700;
  font-size: 30rpx;
}

/* 评分卡片 */
.score-card {
  background: linear-gradient(130deg, #2DD4BF, #0FB9A6);
  border-radius: 40rpx;
  padding: 48rpx;
  color: #fff;
  box-shadow: 0 24rpx 64rpx rgba(45, 212, 191, 0.3);
  margin-bottom: 40rpx;
}

.score-label {
  font-size: 28rpx;
  font-weight: 700;
  opacity: 0.95;
  display: block;
  margin-bottom: 20rpx;
}

.score-display {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.score-number {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1;
}

.score-total {
  opacity: 0.9;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  font-weight: 600;
}

.progress-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.5);
}

/* 优化建议 */
.suggestions-section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
}

.suggestion-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.05);
  margin-bottom: 24rpx;
}

.suggestion-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.suggestion-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.suggestion-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.suggestion-desc {
  font-size: 24rpx;
  color: #6B7787;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid #EEF1F4;
  padding: 20rpx 36rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.bottom-bar .btn-primary {
  width: 100%;
  box-sizing: border-box;
}
