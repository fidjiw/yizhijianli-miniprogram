<!-- pages/profile/profile.wxml -->
<view class="profile-container">
  <!-- 顶部用户信息卡片 -->
  <view class="user-header">
    <view class="user-info">
      <!-- 使用新的头像选择组件 -->
      <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="user-avatar" src="{{userInfo.avatar}}" mode="aspectFill" wx:if="{{userInfo.avatar}}"></image>
        <view class="avatar-placeholder" wx:else>📷</view>
      </button>
      <view class="user-detail">
        <!-- 昵称输入区域 -->
        <input
          class="user-name-input"
          value="{{userInfo.nickname}}"
          placeholder="设置昵称"
          placeholder-class="nickname-placeholder"
          bindblur="onNicknameBlur"
          maxlength="20"
        />
        <text class="user-status">{{userInfo.vip ? '👑 会员用户' : '普通用户'}}</text>
      </view>
    </view>

    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-number">{{userInfo.resumeCount}}</text>
        <text class="stat-label">简历数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{userInfo.aiCount}}</text>
        <text class="stat-label">AI 次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-number">{{userInfo.exportCount}}</text>
        <text class="stat-label">导出数</text>
      </view>
    </view>
  </view>

  <!-- 会员卡片 -->
  <view class="vip-card" bindtap="goToVip">
    <text class="vip-icon">👑</text>
    <view class="vip-content">
      <text class="vip-title">升级会员</text>
      <text class="vip-desc">解锁所有模板 · 无限 AI 次数</text>
    </view>
    <text class="vip-btn">去开通</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToMyTemplates">
      <text class="menu-icon">📦</text>
      <text class="menu-text">我的模板</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToStats">
      <text class="menu-icon">📊</text>
      <text class="menu-text">数据统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">
      退出登录
    </button>
  </view>
</view>
