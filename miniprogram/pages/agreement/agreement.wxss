/* pages/agreement/agreement.wxss */
.agreement-container {
  width: 100%;
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.custom-navbar {
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.navbar-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #374151;
  font-weight: 300;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.navbar-placeholder {
  width: 60rpx;
}

/* 内容滚动区域 */
.content-scroll {
  flex: 1;
  height: 100%;
}

.content {
  padding: 40rpx 32rpx 60rpx;
}

/* 头部 */
.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.update-time,
.effective-time {
  font-size: 24rpx;
  color: #6B7280;
  display: block;
  line-height: 1.8;
}

/* 章节 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.section-content {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.8;
  display: block;
  white-space: pre-line;
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 26rpx;
  color: #9CA3AF;
}
