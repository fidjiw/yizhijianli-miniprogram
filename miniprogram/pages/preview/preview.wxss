/* pages/preview/preview.wxss */
.preview-container {
  min-height: 100vh;
  background: #F4F8F9;
  padding-bottom: 160rpx;
}

.nav-bar {
  background: #fff;
  padding: 16rpx 36rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #EEF1F4;
}

.nav-icon {
  font-size: 36rpx;
  color: #6B7787;
}

.nav-title {
  font-weight: 700;
  font-size: 30rpx;
}

.preview-content {
  padding: 32rpx 36rpx;
  height: calc(100vh - 240rpx);
}

.resume-preview {
  background: #fff;
  border-radius: 32rpx;
  padding: 44rpx;
  box-shadow: 0 16rpx 48rpx rgba(30, 50, 60, 0.08);
}

.resume-header {
  text-align: center;
  padding-bottom: 32rpx;
  border-bottom: 4rpx solid #EEF1F4;
  margin-bottom: 32rpx;
}

.resume-name {
  font-size: 40rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 12rpx;
}

.resume-contact {
  font-size: 22rpx;
  color: #6B7787;
  display: block;
  margin-bottom: 6rpx;
  font-weight: 600;
}

.resume-position {
  font-size: 22rpx;
  color: #6B7787;
  display: block;
  font-weight: 600;
}

.resume-section {
  margin-bottom: 28rpx;
}

.section-title-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.title-marker {
  width: 8rpx;
  height: 28rpx;
  background: #2DD4BF;
  border-radius: 4rpx;
}

.section-title-text {
  font-size: 24rpx;
  font-weight: 800;
}

.section-content {
  font-size: 20rpx;
  line-height: 1.8;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.content-title {
  font-weight: 700;
  margin-bottom: 4rpx;
}

.content-desc {
  color: #6B7787;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.content-item {
  color: #6B7787;
  font-weight: 500;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1px solid #EEF1F4;
  padding: 24rpx 36rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.bottom-bar .btn-secondary,
.bottom-bar .btn-primary {
  flex: 1;
  padding: 22rpx;
  font-size: 26rpx;
}
