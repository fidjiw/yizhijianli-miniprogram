/* pages/preview/preview.wxss */

.preview-container {
  min-height: 100vh;
  background: #F4F8F9;
  padding-bottom: 160rpx;
}

/* 顶部导航 */
.nav-bar {
  background: #fff;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #EEF1F4;
}

.nav-icon {
  font-size: 36rpx;
  color: #6B7787;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-weight: 700;
  font-size: 30rpx;
  color: #1E3240;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
}

.loading-text {
  font-size: 28rpx;
  color: #8F9BA8;
}

/* 预览内容 */
.preview-content {
  height: calc(100vh - 180rpx);
  padding: 32rpx;
}

.resume-preview {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(30, 50, 60, 0.08);
}

/* 简历头部 */
.resume-header {
  text-align: center;
  padding-bottom: 32rpx;
  border-bottom: 2rpx solid #EEF1F4;
  margin-bottom: 40rpx;
}

.resume-name {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: #1E3240;
  margin-bottom: 12rpx;
}

.resume-position {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #0FB9A6;
  margin-bottom: 16rpx;
}

.resume-contact {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
  font-size: 24rpx;
  color: #6B7787;
}

/* 简历区块 */
.resume-section {
  margin-bottom: 40rpx;
}

.resume-section:last-child {
  margin-bottom: 0;
}

.section-title-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.title-marker {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  border-radius: 3rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E3240;
}

/* 区块内容 */
.section-content {
  padding-left: 22rpx;
}

.content-item {
  margin-bottom: 32rpx;
}

.content-item:last-child {
  margin-bottom: 0;
}

.content-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1E3240;
  margin-bottom: 8rpx;
}

.content-desc {
  display: block;
  font-size: 24rpx;
  color: #8F9BA8;
  margin-bottom: 12rpx;
}

.content-text {
  display: block;
  font-size: 26rpx;
  color: #6B7787;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* 技能标签 */
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-tag {
  background: linear-gradient(135deg, #E6FBF7, #D6F5F1);
  color: #0FB9A6;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  border: 1px solid #B3EDE5;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -4rpx 16rpx rgba(30, 50, 60, 0.06);
}

.btn-secondary {
  flex: 1;
  background: #F4F8F9;
  color: #1E3240;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 185, 166, 0.3);
  border: none;
}

.btn-primary::after {
  border: none;
}
