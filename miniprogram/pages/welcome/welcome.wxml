<!--pages/welcome/welcome.wxml-->
<view class="welcome-container">
  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 主内容区 -->
  <view class="content">
    <!-- Logo 图标 -->
    <view class="logo-icon">📄</view>

    <!-- Slogan -->
    <view class="slogan">
      <text class="slogan-main">一张纸\n讲好你的故事</text>
    </view>

    <!-- 描述 -->
    <view class="description">
      <text>海量精选模板 · 智能内容润色</text>
      <text>3 分钟生成一份专业简历</text>
    </view>
  </view>

  <!-- 三个特性卡片 -->
  <view class="features">
    <view class="feature-card">
      <text class="feature-icon">🎨</text>
      <text class="feature-text">精美模板</text>
    </view>
    <view class="feature-card">
      <text class="feature-icon">🤖</text>
      <text class="feature-text">AI 润色</text>
    </view>
    <view class="feature-card">
      <text class="feature-icon">📤</text>
      <text class="feature-text">一键导出</text>
    </view>
  </view>

  <!-- 登录按钮 -->
  <view class="login-section">
    <button class="login-btn" bindtap="handleLogin">
      微信一键登录
    </button>
    <view class="agreement">
      <text>登录即同意</text>
      <text class="link" bindtap="showAgreement">《用户协议》</text>
      <text>和</text>
      <text class="link" bindtap="showPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>
