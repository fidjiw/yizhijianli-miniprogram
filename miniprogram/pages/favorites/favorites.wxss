/* pages/favorites/favorites.wxss */

.favorites-container {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 120rpx;
  background: #F4F8F9;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
}

.loading-text {
  font-size: 28rpx;
  color: #8F9BA8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E3240;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8F9BA8;
  margin-bottom: 48rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(15, 185, 166, 0.3);
}

.empty-btn::after {
  border: none;
}

/* 模板列表 */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.template-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 50, 60, 0.06);
}

/* 预览图 */
.template-preview {
  width: 120rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #EEF8F7, #E0F2F1);
  flex-shrink: 0;
  overflow: hidden;
}

.preview-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-icon {
  font-size: 56rpx;
  opacity: 0.5;
}

/* 模板信息 */
.template-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.template-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1E3240;
}

.template-time {
  font-size: 24rpx;
  color: #8F9BA8;
}

/* 操作按钮 */
.template-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  background: #F4F8F9;
  color: #1E3240;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(15, 185, 166, 0.3);
}
