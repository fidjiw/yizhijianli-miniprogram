<!-- pages/favorites/favorites.wxml -->
<view class="favorites-container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 内容区域 -->
  <view wx:else>
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{empty}}">
      <text class="empty-icon">⭐</text>
      <text class="empty-title">还没有收藏</text>
      <text class="empty-desc">去模板库收藏喜欢的模板吧</text>
      <button class="empty-btn" bindtap="goToTemplates">浏览模板</button>
    </view>

    <!-- 收藏列表 -->
    <view class="template-list" wx:else>
      <view class="template-card" wx:for="{{templates}}" wx:key="_id">
        <view class="template-preview" bindtap="handleUseTemplate" data-id="{{item.templateId}}">
          <view class="preview-placeholder">
            <text class="preview-icon">📄</text>
          </view>
        </view>
        <view class="template-info">
          <text class="template-name">模板 {{item.templateId}}</text>
          <text class="template-time">收藏于 {{item.createdAt}}</text>
        </view>
        <view class="template-actions">
          <button class="action-btn primary" bindtap="handleUseTemplate" data-id="{{item.templateId}}">
            使用
          </button>
          <button class="action-btn" bindtap="handleUnfavorite" data-id="{{item.templateId}}">
            取消收藏
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
