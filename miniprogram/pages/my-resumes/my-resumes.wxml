<!-- pages/my-resumes/my-resumes.wxml -->
<view class="my-resumes-container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 内容区域 -->
  <view wx:else>
    <!-- 头部 -->
    <view class="header">
      <text class="page-title">我的简历</text>
      <button class="create-btn" bindtap="createNew">＋ 新建</button>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{empty}}">
      <text class="empty-icon">📄</text>
      <text class="empty-title">还没有简历</text>
      <text class="empty-desc">创建你的第一份简历吧</text>
      <button class="empty-btn" bindtap="createNew">立即创建</button>
    </view>

    <!-- 简历列表 -->
    <view class="resume-list" wx:else>
      <view class="resume-card" wx:for="{{resumes}}" wx:key="_id">
        <!-- 简历缩略图 -->
        <view class="resume-thumbnail" bindtap="handleResumeClick" data-id="{{item._id}}">
          <view class="thumbnail-placeholder">
            <text class="thumbnail-icon">📄</text>
          </view>
        </view>

        <!-- 简历信息 -->
        <view class="resume-info" bindtap="handleResumeClick" data-id="{{item._id}}">
          <text class="resume-title">{{item.name || '未命名简历'}}</text>
          <text class="resume-position">{{item.position || '职位未设置'}}</text>
          <view class="resume-meta">
            <text class="resume-template">{{item.templateName || '清新简约'}}</text>
            <text class="resume-time">更新于 {{item.updatedAt}}</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="resume-actions">
          <button class="action-btn" bindtap="handleEdit" data-id="{{item._id}}">
            <text class="action-icon">✏️</text>
          </button>
          <button class="action-btn" bindtap="handlePreview" data-id="{{item._id}}">
            <text class="action-icon">👁️</text>
          </button>
          <button class="action-btn" bindtap="handleDelete" data-id="{{item._id}}" data-name="{{item.name}}">
            <text class="action-icon">🗑️</text>
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
