/* pages/templates/templates.wxss */
.templates-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 顶部 */
.header {
  padding: 16rpx 36rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 28rpx;
}

/* 搜索框 */
.search-box {
  background: #fff;
  border-radius: 56rpx;
  padding: 18rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.05);
}

.search-icon {
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #6B7787;
}

/* 分类标签 */
.category-scroll {
  padding: 28rpx 36rpx 12rpx;
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 16rpx;
}

.category-list .chip {
  flex-shrink: 0;
}

/* 模板网格 */
.templates-grid {
  padding: 8rpx 36rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.template-card {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.06);
}

.template-preview {
  height: 280rpx;
  position: relative;
  padding: 20rpx;
}

.template-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
}

.template-info {
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
}

.template-name {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.template-desc {
  font-size: 20rpx;
  color: #6B7787;
}
