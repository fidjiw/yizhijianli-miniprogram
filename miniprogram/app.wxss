/**app.wxss**/
page {
  background: linear-gradient(160deg, #EAF6F4, #F4F8F9 40%);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #1F2A37;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 颜色变量 */
.color-mint { color: #2DD4BF; }
.color-mint-d { color: #0FB9A6; }
.color-coral { color: #FF8A6B; }
.color-ink { color: #1F2A37; }
.color-gray { color: #6B7787; }

.bg-mint { background: #2DD4BF; }
.bg-mint-l { background: #E6FBF7; }
.bg-coral { background: #FF8A6B; }
.bg-coral-l { background: #FFEDE6; }
.bg-white { background: #FFFFFF; }
.bg-gray { background: #F0F2F5; }

/* 通用布局 */
.container {
  padding: 40rpx;
  min-height: 100vh;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.05);
}

.card-gradient {
  background: linear-gradient(120deg, #2DD4BF, #0FB9A6);
  border-radius: 40rpx;
  padding: 36rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #2DD4BF, #0FB9A6);
  color: #fff;
  padding: 28rpx 48rpx;
  border-radius: 60rpx;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(45, 212, 191, 0.35);
}

.btn-secondary {
  border: 3rpx solid #2DD4BF;
  color: #0FB9A6;
  background: #fff;
  padding: 26rpx 48rpx;
  border-radius: 60rpx;
  font-weight: 700;
  font-size: 30rpx;
  text-align: center;
}

/* 标签 chip */
.chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 60rpx;
  font-size: 22rpx;
  background: #E6FBF7;
  color: #0FB9A6;
  font-weight: 600;
}

.chip-coral {
  background: #FFEDE6;
  color: #FF8A6B;
}

.chip-gray {
  background: #F0F2F5;
  color: #6B7787;
}

/* 标题 */
.title-large {
  font-size: 40rpx;
  font-weight: 800;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
}

.title-small {
  font-size: 28rpx;
  font-weight: 700;
}

/* 文本 */
.text-gray {
  color: #6B7787;
  font-size: 24rpx;
}

.text-small {
  font-size: 22rpx;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mt-40 { margin-top: 40rpx; }

.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }

.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }

.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

/* 阴影 */
.shadow {
  box-shadow: 0 8rpx 28rpx rgba(30, 50, 60, 0.05);
}

.shadow-lg {
  box-shadow: 0 16rpx 48rpx rgba(30, 50, 60, 0.08);
}
